[TEMPLATE]
PORT=5000
FRONTEND_URL=http://localhost:5173
AUTH= # generate with: bunx auth secret or openssl rand -hex 32 (min 32 chars)
AUTH_URL=http://localhost:5000
AUTH_TRUST_HOST=true
# Google — https://authjs.dev/getting-started/problem/google?framework=Express — callback: http://localhost:5000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Quickstart env — CLI uses MONGODB_URL, app uses DATABASE_URL (export both per https://www.prisma.io/docs/prisma-orm/quickstart/mongodb)
MONGODB_URL="mongodb://localhost:27017/mydb?replicaSet=rs0&directConnection=true"
DATABASE_URL="mongodb://localhost:27017/mydb?replicaSet=rs0&directConnection=true"
# For Atlas, use: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/mydb?retryWrites=true&w=majority
# Resend — email verification for credentials (only credentials need verification; Google is auto-verified)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM="TalentHive <onboarding@resend.dev>"
# UploadThing — file uploads (avatar/attachments) — https://docs.uploadthing.com/backend-adapters/express
UPLOADTHING_TOKEN=eyJhcGlLZXkiOiJ... # from https://uploadthing.com/backend-adapters/express
# Stripe — Connect verification + escrow (https://dashboard.stripe.com)
STRIPE_KEY=sk_test_...
STRIPE_WEBHOOK=whsec_...
STRIPE_PUBLIC_KEY=pk_test_...
# Webhook via ngrok: https://unwavered-nash-geotactically.ngrok-free.dev/api/webhook/stripe -> http://localhost:5000/api/webhook/stripe
FRONTEND_URL=http://localhost:5173
# Escrow — platform cut taken when funded milestones release to the freelancer
PLATFORM_FEE_PERCENT=10
# OpenRouter — AI proposal recommendations (server-side only, never expose this key to the client)
OPENROUTER_API_KEY=sk-or-v1-... # https://openrouter.ai/keys
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free # preferred model; free pools are often 429 upstream
# Tried in order when the preferred model 429s, errors or answers garbage (comma-separated)
OPENROUTER_FALLBACK_MODELS=nfield/nemotron-3-ultra-550b-a55b:free
# Inngest — durable background jobs (https://www.inngest.com/docs) — Dev Server: npx inngest-cli@latest dev -u http://localhost:5000/api/inngest
INNGEST_DEV=1
# Signing key from https://www.inngest.com/app (required for signed Inngest Cloud; optional locally)
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=dev
# Vercel deployment config
NODE_ENV=production
VERCEL_URL=
VERCEL_ENV=